---
// 十二宫详情页：/self-awareness/01 … /self-awareness/12
import BaseLayout from "../../layouts/BaseLayout.astro";
import { palaces } from "../../data/palaces";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

export function getStaticPaths() {
  return palaces.map((p) => ({
    params: { id: p.no },
    props: { p },
  }));
}

const { p } = Astro.props;

// 01 命宫 · 灵魂：分步内容（一次一部分，按钮翻页 + 字从四面八方飞入/飞散）
// c 为行样式：t-big 宋体大字 / t-note 小注 / t-turn 强调 / t-final 收束大字
const soulParts = [
  {
    kicker: "起点",
    rows: [
      { t: "在进入这一站之前，先把理性放一放" },
      { t: "这一站，我们只谈——<em>灵魂</em>" },
      { t: "这里没有标准答案，只有你对自己诚实的程度", c: "t-note" },
    ],
  },
  {
    kicker: "关于存在的四句话",
    rows: [
      { t: "我说，我存在于这个世界上——<em>直觉</em>", c: "t-big" },
      { t: "我说，你们存在于这个世界上——<em>理性</em>", c: "t-big" },
      { t: "我说，灵魂存在于我的身体里——<em>理性</em>", c: "t-big" },
      { t: "我说，灵魂存在于你们的身体里——<em>直觉</em>", c: "t-big" },
      { t: "你发现了吗——四句话里，「我」始终是主语", c: "t-note" },
    ],
  },
  {
    kicker: "两种「我」",
    rows: [
      { t: "<em>我与他</em>——我把你变成了工具：点饭、问路、坐车" },
      { t: "<em>我与你</em>——我遇见纯粹的你：心动，和脱口而出的「我爱你」" },
      { t: "工具可以被替代，但「你」只有一个", c: "t-note" },
      { t: "只有「我与你」在场时，灵魂才真正在场", c: "t-turn" },
    ],
  },
  {
    kicker: "转折",
    rows: [
      { t: "我证明我的灵魂，我证明我的存在——", c: "t-big" },
      { t: "可谈及他人时，我被剔除了", c: "t-big" },
      { t: "原来证明灵魂存在的方式，是去爱具体的人", c: "t-note" },
      { t: "你们的存在，是我灵魂的证明", c: "t-turn" },
    ],
  },
  {
    kicker: "王阳明 · 东方",
    rows: [
      { t: "人心一点灵明，是天地万物的感应中枢" },
      { t: "王阳明说，心外无物——万物都在你的感应里", c: "t-note" },
      { t: "生死，不过是气的往来——昼夜，便是生死" },
      { t: "心即理：个体消亡后，良知回归大地，与万物同体" },
      {
        t: "灵魂不是不朽的实体，而是宇宙气化的暂存态——在聚散中转化，而非消亡",
        c: "t-turn",
      },
    ],
  },
  {
    kicker: "尼采 · 西方",
    rows: [
      { t: "上帝已死——信仰不再纯粹，神沦为安慰剂" },
      { t: "人要走过三个阶段：" },
      { t: "<em>骆驼</em>——别人说什么，我就做什么" },
      { t: "<em>狮子</em>——我想做什么，就做什么" },
      { t: "<em>婴孩</em>——我是……" },
      { t: "骆驼背负规则，狮子打破规则，婴孩创造规则", c: "t-note" },
      { t: "灵魂越是纯洁，人越是完整", c: "t-turn" },
    ],
  },
  {
    kicker: "终点",
    rows: [
      { t: "东西方绕了很远，最后都指向同一件事——", c: "t-big" },
      { t: "所有的路，都是回家的路", c: "t-note" },
      { t: "我与我们", c: "t-final" },
    ],
  },
];
---

<BaseLayout title={`${p.name} · ${p.hover} —— 自我觉察：十二之旅`}>
  <div class="page-head">
    <span class="sec-no">十二宫 · {p.no} / 12</span>
    <h1>
      {p.name}
      <span class="h-alt">· {p.hover}</span>
    </h1>
  </div>

  {p.no === "01" ? (
    <div class="player">
      <button id="btn-prev" class="nav-btn" aria-label="上一部分">←</button>

      <div class="soul">
        <!-- 分步内容：一次只显示当前 part -->
        {soulParts.map((part, pi) => (
          <div class="part">
            <p class="t-kicker">
              <span class="k-no">{String(pi + 1).padStart(2, "0")}</span>
              {part.kicker}
            </p>
            {part.rows.map((row) => (
              <p class={"t-line" + (row.c ? " " + row.c : "")} set:html={row.t} />
            ))}
          </div>
        ))}

        <!-- 进度指示 -->
        <p class="t-progress"><span id="part-no">1</span> / {soulParts.length}</p>
      </div>

      <button id="btn-next" class="nav-btn" aria-label="下一部分">→</button>
    </div>
  ) : p.no === "02" ? (
    <div class="film">
      <!-- Scene 1 开场：扎心提问 -->
      <section class="scene" style="--h: 240vh">
        <div class="scene-sticky">
          <p class="s-line">先问个扎心的问题：<em>你现在有真正的朋友吗？</em></p>
          <p class="s-line">不是加了微信躺列的那种，而是你愿意把最难看、最丢脸的一面拿出来给他看的人。</p>
          <p class="s-line">什么叫朋友？<em>彼此相识、彼此来往、彼此在乎。</em></p>
          <p class="s-line">就这么简单，也这么难。</p>
        </div>
      </section>

      <!-- Scene 2 故事一：小学三年级 -->
      <section class="scene" style="--h: 280vh">
        <div class="scene-sticky">
          <p class="s-kicker"><span class="s-no">一</span>我讲两个故事 · 小学三年级</p>
          <p class="s-line">有个同学周末叫我陪他去教室拿作业。到门口门锁着，我下楼找保安拿钥匙，回来门已经被撞开了。</p>
          <p class="s-line">周一我被叫家长，他把整件事说成是我的主意。</p>
          <p class="s-line">那一刻我顾不上生气，只觉得难堪，心里空了一块。</p>
          <p class="s-line">后来他周末还找我玩，但我已经高兴不起来了——因为我知道，真出了事，他会选那个对自己最省事的说法。</p>
        </div>
      </section>

      <!-- Scene 3 故事二：高中耳塞 -->
      <section class="scene" style="--h: 240vh">
        <div class="scene-sticky">
          <p class="s-kicker"><span class="s-no">二</span>第二个 · 高中</p>
          <p class="s-line">我跟他吐槽室友打呼噜，他没跟我一起骂，反而说：“你不能买个耳塞吗？”</p>
          <p class="s-line">后来一次考试考砸，上课时他递来一张纸条，就一行字：</p>
          <p class="s-line note">“晚上来我宿舍，拿副耳塞。”</p>
        </div>
      </section>

      <!-- Scene 4 顿悟：金句 -->
      <section class="scene" style="--h: 220vh">
        <div class="scene-sticky">
          <p class="s-line big">有人陪你骂世界，那是<em>暂时的同伙</em>；</p>
          <p class="s-line big">有人在你最狼狈时递给你真正需要的东西，那才是<em>走进你生命里的人</em>。</p>
        </div>
      </section>

      <!-- Scene 5 朋友三圈：滚动中逐层拆解 -->
      <section class="scene" style="--h: 340vh">
        <div class="scene-sticky">
          <div class="rings film-rings">
            <div class="ring r-outer" data-key="outer"><span class="r-label">点头之交</span></div>
            <div class="ring r-mid" data-key="mid"><span class="r-label">玩伴 · 搭子</span></div>
            <div class="ring r-core" data-key="core"><span class="r-label">真心朋友</span></div>
          </div>
          <p class="s-line">真正在里面的，<em>一两个人就够了</em>。</p>
        </div>
      </section>

      <!-- Scene 6 五件小事：逐条点亮 -->
      <section class="scene" style="--h: 340vh">
        <div class="scene-sticky">
          <p class="s-line lead-line">那怎么交朋友？给你五件能做的小事——</p>
          <p class="s-line"><em>01</em> 把人放对位置。别一上来就当此生挚友，也别因为一次失望就贴标签，慢慢看谁真的在乎你。</p>
          <p class="s-line"><em>02</em> 把“我不太舒服”说出来，而不是憋两天把自己气个半死。真朋友经得起一次小磨合。</p>
          <p class="s-line"><em>03</em> 给彼此留空间。发一大段吐槽前先问一句：“你现在有空吗？”别把一个人变成你的情绪垃圾桶。</p>
          <p class="s-line"><em>04</em> 接受有些关系只到这里。总在你需要时才出现、总把话题岔开的人，允许他往外放一点。</p>
          <p class="s-line"><em>05</em> 先成为那样一个人。比遇到一个真心朋友更重要的，是先练习成为那样一个人：守住秘密、守住时间、守住分寸。</p>
        </div>
      </section>

      <!-- Scene 7 阶段性 -->
      <section class="scene" style="--h: 240vh">
        <div class="scene-sticky">
          <p class="s-line">很多朋友确实是阶段性的，换城市、换轨道，就慢慢淡了。</p>
          <p class="s-line">但阶段性不等于虚假——一起熬过的夜、吹过的冷风，都是真的。他陪你走完了那段你很需要不那么孤单的路，这就够珍贵了。</p>
          <p class="s-line">但也有人会一遍一遍留下来，穿过好几个阶段还在你生命里。</p>
        </div>
      </section>

      <!-- Scene 8 结尾：金句大字 -->
      <section class="scene" style="--h: 280vh">
        <div class="scene-sticky">
          <p class="s-line big">所以朋友是什么？</p>
          <p class="s-line big">朋友不是能陪你活一辈子的人，</p>
          <p class="s-line big">而是在很吵、很快、很容易走散的世界里，<em>愿意为你停下脚步的人</em>。</p>
          <p class="s-line sub">我们都在等一个不会离开的朋友。那不如从今天开始，先做一个不会轻易离开别人、值得被信任的人。</p>
        </div>
      </section>

      <nav class="p-nav">
        <a href={base + "/self-awareness"}>← 返回十二之旅</a>
      </nav>
    </div>
  ) : (
    <>
      <section class="p-intro">
        <p>
          在紫微斗数里，{p.name}对应人生中「<strong>{p.hover}</strong>」这个主题。
          这一站要问的问题很简单，也很难回答——
        </p>
        <p class="p-q-big">{p.q}</p>
      </section>

      <div class="placeholder">
        <p>🚧 「{p.hover}」主题的内容正在整理中</p>
        <p style="margin-top: 0.5rem;">每一站，都会慢慢长出属于它的思考。</p>
      </div>

      <nav class="p-nav">
        <a href={base + "/self-awareness"}>← 返回十二之旅</a>
      </nav>
    </>
  )}
</BaseLayout>

<style>
  /* 页头小标 */
  .page-head .sec-no {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  /* 标题中的主题词（accent 色） */
  .h-alt {
    color: var(--accent);
    font-size: 0.72em;
    letter-spacing: 0.1em;
  }

  /* ===== 播放器：按钮在内容左右两侧 ===== */
  .player {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2.4rem;
  }

  /* 翻页按钮：accent 描边圆，明显可见 */
  .nav-btn {
    flex-shrink: 0;
    width: 68px;
    height: 68px;
    border-radius: 50%;
    border: 1.5px solid var(--accent);
    background: var(--bg-card);
    color: var(--accent);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    transition: all 0.25s ease;
    box-shadow: var(--shadow);
  }

  .nav-btn:hover {
    background: var(--accent);
    color: #ffffff;
    transform: scale(1.08);
  }

  /* ===== 01 灵魂页：分步播放器（文字居中） ===== */
  .soul {
    position: relative;
    flex: 1;
    max-width: 44em;
    min-height: 46vh;
    text-align: center;
  }

  /* 每部分：默认隐藏，active 显示 */
  .part {
    display: none;
  }

  .part.active {
    display: block;
  }

  /* 部分小标（编号 + 标题，居中） */
  .t-kicker {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    margin-bottom: 3.2rem;
    font-size: 29px;
    font-weight: 600;
    letter-spacing: 0.3em;
    color: var(--accent);
  }

  .k-no {
    font-size: 35px;
    letter-spacing: 0.1em;
    color: var(--text);
    font-weight: 700;
    font-family: var(--font-serif);
  }

  /* 行 */
  .t-line {
    margin-bottom: 2.6rem;
    font-size: 18px;
    line-height: 1.7;
    color: var(--muted);
  }

  .t-line em {
    font-style: normal;
    font-weight: 600;
    color: var(--accent);
  }

  .t-big {
    font-family: var(--font-serif);
    font-weight: 700;
    line-height: 1.6;
    color: var(--muted);
  }

  .t-note {}

  /* 强调句：居中 + 上下细线（白色，其余句子灰色） */
  .t-turn {
    margin: 2.4rem auto;
    padding: 1.6rem 0;
    max-width: 24em;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-serif);
    font-weight: 700;
    line-height: 1.6;
    color: var(--text);
  }

  /* 收束句：颜色保持 accent */
  .t-final {
    margin-top: 2rem;
    font-family: var(--font-serif);
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--accent);
    line-height: 1.4;
  }

  /* 进度指示 */
  .t-progress {
    margin-top: 3.6rem;
    text-align: center;
    font-size: 15px;
    color: var(--muted);
    letter-spacing: 0.15em;
  }

  /* ===== 文字动画：四面八方飞入组合，离开倒放飞散 ===== */
  .t-line .w {
    display: inline-block;
    opacity: 0;
    transform: translate(var(--dx, 0px), var(--dy, 0px)) rotate(var(--rot, 0deg)) scale(0.4);
    filter: blur(6px);
    transition:
      opacity 0.55s ease,
      transform 0.55s cubic-bezier(0.2, 0.7, 0.2, 1),
      filter 0.55s ease;
    transition-delay: calc(var(--ld, 0s) + var(--d, 0s));
  }

  .t-line.show .w {
    opacity: 1;
    transform: none;
    filter: none;
  }

  .t-line.hide .w {
    opacity: 0;
    transform: translate(var(--dx2, 0px), var(--dy2, 0px)) rotate(var(--rot2, 0deg)) scale(0.4);
    filter: blur(6px);
  }

  /* ===== 02 兄弟宫 · 朋友：口述电台式 ===== */
  .talk {
    max-width: 40em;
    margin: 0 auto;
    padding-top: 0.5rem;
  }

  /* 口述段落：滚动进入视口时逐行浮现（animation，stagger 用 animation-delay） */
  .f-row {
    margin-bottom: 2.6rem;
    font-size: 22px;
    line-height: 2;
    color: var(--muted);
    opacity: 0;
    transform: translateY(26px);
  }

  .f-row.visible {
    animation: rise 0.8s ease forwards;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(26px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .f-row em {
    font-style: normal;
    font-weight: 600;
    color: var(--accent);
  }

  /* 开场提问：更重一点 */
  .f-row.lead {
    font-family: var(--font-serif);
    font-size: 26px;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--text);
    line-height: 1.8;
  }

  /* 故事区块：左侧竖线，像口述稿的段落感 */
  .story {
    margin: 3.4rem 0;
    padding-left: 1.6rem;
    border-left: 2px solid var(--accent);
  }

  .story .f-row {
    margin-bottom: 2rem;
  }

  .s-kicker {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 2.2rem;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    color: var(--accent);
    opacity: 0;
    transform: translateY(26px);
  }

  .s-kicker.visible {
    animation: rise 0.8s ease forwards;
  }

  .s-no {
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--gold);
    letter-spacing: 0.1em;
  }

  /* 顿悟金句：居中 + 上下细线 */
  .f-row.turn {
    margin: 3.4rem auto;
    padding: 1.9rem 0;
    max-width: 26em;
    text-align: center;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 24px;
    line-height: 1.9;
    color: var(--text);
  }

  .f-row.turn em {
    color: var(--gold);
  }

  /* 结尾大字 */
  .f-row.final {
    margin: 3rem auto 1.4rem;
    max-width: 26em;
    text-align: center;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 30px;
    line-height: 1.8;
    letter-spacing: 0.04em;
    color: var(--text);
  }

  .f-row.final em {
    color: var(--gold);
  }

  .f-row.final.sub {
    font-size: 22px;
    font-weight: 500;
    color: var(--muted);
    margin-top: 0.4rem;
  }

  /* 五件小事：编号清单卡片 */
  .five {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.1rem;
    margin: 2.6rem 0 3.6rem;
  }

  .f-item {
    padding: 1.5rem 1.6rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    opacity: 0;
    transform: translateY(26px);
    transition: box-shadow 0.25s ease, background 0.25s ease;
  }

  .f-item.visible {
    animation: rise 0.8s ease forwards;
  }

  .f-item:hover {
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--gold) 38%, transparent),
      var(--shadow);
    background: color-mix(in srgb, var(--gold) 7%, var(--bg-card));
  }

  .f-no {
    display: block;
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 700;
    color: var(--gold);
    letter-spacing: 0.15em;
    margin-bottom: 0.8rem;
  }

  .f-item p {
    font-size: 22px;
    line-height: 1.85;
    color: var(--muted);
  }

  /* ===== 朋友三圈：同心圆交互图 ===== */
  .rings-wrap {
    margin: 4rem 0 3.6rem;
  }

  .rings {
    position: relative;
    width: min(420px, 78vw);
    aspect-ratio: 1 / 1;
    margin: 0 auto;
  }

  .ring {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .r-outer {
    width: 100%;
    height: 100%;
    border: 1.5px solid var(--border);
    background: color-mix(in srgb, var(--accent) 4%, transparent);
  }

  .r-mid {
    width: 66%;
    height: 66%;
    border: 1.5px solid var(--border);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .r-core {
    width: 33%;
    height: 33%;
    border: 1.5px solid var(--gold);
    background: color-mix(in srgb, var(--gold) 14%, transparent);
  }

  /* 圈名标签：错位分布在各自圈的边缘（不再挤在圆心） */
  .r-label {
    font-family: var(--font-serif);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--muted);
    opacity: 1;
    pointer-events: none;
    transition: color 0.3s ease;
    text-align: center;
    line-height: 1.5;
    padding: 3px 12px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
  }

  /* 外圈标签：圈顶部；中圈标签：圈底部；内圈标签：圈中心 */
  .r-outer .r-label {
    position: absolute;
    top: 5%;
  }

  .r-mid .r-label {
    position: absolute;
    bottom: 7%;
  }

  .r-core .r-label {
    position: relative;
  }

  /* hover：整圈高亮发光，标签变亮 */
  .r-outer:hover {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 14%, transparent),
      0 0 50px 8px color-mix(in srgb, var(--accent) 18%, transparent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .r-mid:hover {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 16%, transparent),
      0 0 50px 8px color-mix(in srgb, var(--accent) 22%, transparent);
    background: color-mix(in srgb, var(--accent) 16%, transparent);
  }

  .r-core:hover {
    border-color: var(--gold);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--gold) 18%, transparent),
      0 0 50px 10px color-mix(in srgb, var(--gold) 26%, transparent);
    background: color-mix(in srgb, var(--gold) 24%, transparent);
  }

  .ring:hover .r-label {
    color: var(--text);
  }

  /* 内圈 hover：标签转金色 */
  .r-core:hover .r-label {
    color: var(--gold);
  }

  /* 圆心：固定文字，永远可见 */
  .rings-center {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-serif);
    font-size: 26px;
    font-weight: 700;
    letter-spacing: 0.3em;
    color: var(--text);
    pointer-events: none;
  }

  .ring-hint {
    margin-top: 1.4rem;
    text-align: center;
    font-size: 15px;
    color: var(--muted);
    letter-spacing: 0.15em;
  }

  /* 说明区：hover 圈时切换 */
  .ring-desc {
    margin: 1.6rem auto 0;
    max-width: 30em;
    min-height: 4.6em;
    padding: 1.5rem 2rem;
    text-align: center;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-serif);
    font-size: 22px;
    line-height: 2;
    color: var(--text);
  }

  .rings-note {
    margin: 2.6rem auto 0;
    max-width: 26em;
    text-align: center;
  }

  /* ===== 02 兄弟宫 · 朋友：滚动叙事电影 ===== */
  .film {
    max-width: 44em;
    margin: 0 auto;
    counter-reset: scene;
  }

  .scene {
    position: relative;
    height: var(--h, 240vh);
    counter-increment: scene;
  }

  .scene-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0 1.5rem;
    overflow: hidden;
  }

  /* 块分隔：场景序号位于正文上方，间距可调 */
  .scene-sticky::before {
    content: counter(scene, decimal-leading-zero) " / 08";
    position: static;
    margin-bottom: 1.2rem;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.35em;
    color: var(--muted);
    opacity: 0.55;
    pointer-events: none;
    white-space: nowrap;
  }

  /* 叙事行：默认暗淡，滚动推进时依次点亮 */
  .s-line {
    max-width: 26em;
    text-align: center;
    font-size: 22px;
    line-height: 1.8;
    color: var(--muted);
    opacity: 0.15;
    transform: translateY(16px);
    transition: opacity 0.55s ease, transform 0.55s ease, color 0.55s ease;
  }

  .s-line.on {
    opacity: 1;
    transform: translateY(0);
    color: var(--text);
  }

  .s-line em {
    font-style: normal;
    font-weight: 600;
    color: var(--accent);
  }

  /* 大字行（顿悟/结尾）：字号与正文统一，保留宋体字重与金色强调 */
  .s-line.big {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 700;
    line-height: 1.8;
  }

  .s-line.big em {
    color: var(--gold);
  }

  /* 耳塞纸条：特殊强调 */
  .s-line.note {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--gold);
  }

  /* 引导行 */
  .s-line.lead-line {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 700;
    color: var(--text);
  }

  /* 收束行 */
  .s-line.sub {
    font-size: 22px;
    color: var(--muted);
  }

  /* 场景小标 */
  .s-kicker {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: 0.3em;
    color: var(--accent);
    opacity: 0.15;
    transition: opacity 0.55s ease;
    /* 块标题与正文拉开距离 */
    margin-bottom: 1.5rem;
  }

  .s-kicker.on {
    opacity: 1;
  }

  .s-no {
    font-family: var(--font-serif);
    font-size: 22px;
    color: var(--gold);
  }

  /* 三圈拆解：滚动中逐层出现 */
  .film-rings {
    width: min(400px, 72vw);
    margin-bottom: 0.5rem;
  }

  .film-rings .ring {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.9);
  }

  .film-rings .ring.on {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  .film-rings .rings-center {
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .film-rings .rings-center.on {
    opacity: 1;
  }

  /* ===== 其他宫（占位页）样式 ===== */
  .p-intro {
    padding: 1.2rem 0 1.2rem 1.6rem;
    border-left: 2px solid var(--accent);
    max-width: 42em;
  }

  .p-intro p {
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 2.05;
  }

  .p-intro strong {
    color: var(--text);
    font-weight: 600;
  }

  .p-q-big {
    margin-top: 1rem;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--text);
  }

  .p-nav {
    margin-top: 2.2rem;
    text-align: center;
    font-size: 0.92rem;
  }

  .p-nav a {
    color: var(--muted);
    border-bottom: 1px solid transparent;
    transition: all 0.2s ease;
  }

  .p-nav a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* ===== 响应式（移动端：按钮固定底部、字号适配） ===== */
  @media (max-width: 720px) {
    .player {
      display: block;
    }

    .nav-btn {
      position: fixed;
      bottom: 1.2rem;
      width: 58px;
      height: 58px;
      font-size: 18px;
      z-index: 60;
    }

    .nav-btn:first-child {
      left: 1rem;
    }

    .nav-btn:last-child {
      right: 1rem;
    }

    .t-kicker {
      font-size: 19px;
      margin-bottom: 2.4rem;
    }

    .k-no {
      font-size: 23px;
    }

    .t-line {
      font-size: 10px;
      margin-bottom: 1.8rem;
    }

    .t-big {
    }

    .t-note {
    }

    .t-turn {
      padding: 1.2rem 0;
    }

    .t-progress {
      font-size: 13px;
      margin-top: 2.6rem;
    }

    .soul {
      min-height: 38vh;
    }

    /* 口述页移动端 */
    .talk {
      padding-top: 0.2rem;
    }

    .f-row {
      font-size: 18px;
      margin-bottom: 2.2rem;
    }

    .f-row.lead {
      font-size: 22px;
    }

    .f-row.turn {
      font-size: 20px;
      padding: 1.5rem 0;
    }

    .f-row.final {
      font-size: 24px;
    }

    .f-row.final.sub {
      font-size: 18px;
    }

    .f-item p {
      font-size: 18px;
    }

    .f-no {
      font-size: 20px;
    }

    .five {
      grid-template-columns: 1fr;
    }
  }
</style>

<style is:global>
  /* ===== 文字动画（is:global：作用于 JS 动态创建的 .w 字节点） ===== */
  .t-line .w {
    display: inline-block;
    opacity: 0;
    transform: translate(var(--dx, 0px), var(--dy, 0px)) rotate(var(--rot, 0deg)) scale(0.4);
    filter: blur(6px);
    transition:
      opacity 0.55s ease,
      transform 0.55s cubic-bezier(0.2, 0.7, 0.2, 1),
      filter 0.55s ease;
    transition-delay: calc(var(--ld, 0s) + var(--d, 0s));
  }

  .t-line.show .w {
    opacity: 1;
    transform: none;
    filter: none;
  }

  .t-line.hide .w {
    opacity: 0;
    transform: translate(var(--dx2, 0px), var(--dy2, 0px)) rotate(var(--rot2, 0deg)) scale(0.4);
    filter: blur(6px);
  }
</style>

<script>
  // 分步播放器：一次显示一部分，循环翻页
  // 进入：每个字从四面八方随机位置飞入组合；离开：字飞散消失后切页
  const parts = document.querySelectorAll(".part");
  if (parts.length) {
    const btnPrev = document.getElementById("btn-prev");
    const btnNext = document.getElementById("btn-next");
    const partNo = document.getElementById("part-no");
    const total = parts.length;
    let idx = 0;
    let animating = false;

    const rand = (m) => Math.random() * m * 2 - m;

    // 把行文本拆成单字 span（保留 em 高亮结构），并赋予随机飞行起点
    const split = (el) => {
      const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
      const nodes = [];
      while (walker.nextNode()) nodes.push(walker.currentNode);
      nodes.forEach((node) => {
        if (!node.textContent.trim()) return;
        const frag = document.createDocumentFragment();
        [...node.textContent].forEach((ch, i) => {
          const s = document.createElement("span");
          s.className = "w";
          s.textContent = ch === " " ? "\u00A0" : ch;
          s.style.setProperty("--d", Math.min(i * 0.03, 1) + "s");
          s.style.setProperty("--dx", rand(340) + "px");
          s.style.setProperty("--dy", rand(340) + "px");
          s.style.setProperty("--rot", rand(50) + "deg");
          frag.appendChild(s);
        });
        node.parentNode.replaceChild(frag, node);
      });
    };

    // 播放当前部分：字从四面八方飞入组合
    const playIn = (n) => {
      const lines = parts[n].querySelectorAll(".t-line");
      lines.forEach((l, li) => {
        if (!l.dataset.done) {
          split(l);
          l.dataset.done = "1";
        }
        l.style.setProperty("--ld", li * 0.12 + "s");
        l.classList.remove("hide");
      });
      void parts[n].offsetWidth;
      lines.forEach((l) => l.classList.add("show"));
    };

    // 翻页：当前部分字飞散（倒放）→ 切页 → 新字飞入
    const flyOut = (next) => {
      if (animating) return;
      animating = true;
      const cur = parts[idx];
      cur.querySelectorAll(".t-line").forEach((l) => {
        l.querySelectorAll(".w").forEach((w) => {
          w.style.setProperty("--dx2", rand(380) + "px");
          w.style.setProperty("--dy2", rand(380) + "px");
          w.style.setProperty("--rot2", rand(80) + "deg");
        });
        l.classList.remove("show");
        l.classList.add("hide");
      });
      setTimeout(() => {
        idx = next;
        parts.forEach((el, i) => el.classList.toggle("active", i === next));
        partNo.textContent = String(next + 1);
        playIn(next);
        window.scrollTo({ top: 0, behavior: "smooth" });
        animating = false;
      }, 620);
    };

    btnPrev.addEventListener("click", () => {
      flyOut((idx - 1 + total) % total);
    });
    btnNext.addEventListener("click", () => {
      flyOut((idx + 1) % total);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") flyOut((idx - 1 + total) % total);
      if (e.key === "ArrowRight") flyOut((idx + 1) % total);
    });

    // 首屏
    parts.forEach((el, i) => el.classList.toggle("active", i === 0));
    partNo.textContent = "1";
    playIn(0);
  }

  // ===== 02 兄弟宫 · 朋友：滚动叙事电影（sticky 场景 + 进度驱动） =====
  const scenes = document.querySelectorAll(".scene");
  if (scenes.length) {
    let filmTicking = false;
    const clamp01 = (v) => Math.min(1, Math.max(0, v));

    function driveFilm() {
      filmTicking = false;
      scenes.forEach((scene) => {
        const rect = scene.getBoundingClientRect();
        const total = scene.offsetHeight - window.innerHeight;
        // 场景顶部贴视口顶 → 进度 0；滚完可滚动距离 → 进度 1
        const p = total > 0 ? clamp01(-rect.top / total) : 1;

        // 行依次点亮（含场景小标）
        const lines = scene.querySelectorAll(".s-line, .s-kicker");
        const n = lines.length;
        lines.forEach((line, i) => {
          line.classList.toggle("on", p >= (i + 0.3) / n);
        });

        // 三圈拆解：外 → 中 → 内 → 圆心
        const rings = scene.querySelectorAll(".ring");
        if (rings.length) {
          rings.forEach((r, i) => {
            r.classList.toggle("on", p >= i * 0.22 + 0.04);
          });
          const c = scene.querySelector(".rings-center");
          if (c) c.classList.toggle("on", p >= 0.72);
        }
      });
    }

    window.addEventListener(
      "scroll",
      () => {
        if (!filmTicking) {
          filmTicking = true;
          requestAnimationFrame(driveFilm);
        }
      },
      { passive: true }
    );
    driveFilm();
  }

  // ===== 三圈同心圆：hover 切换说明文字（仅带说明区的页面使用） =====
  const ringText = document.getElementById("ring-text");
  const ringDescs = {
    outer: "点头之交——认识，但生活只是轻轻碰了一下。",
    mid: "玩伴 · 搭子——一起吃饭、打游戏、吐槽，但你不了解他真正怕什么。",
    core: "真心朋友——你愿意像剥洋葱一样把心一层层给他看，他知道会认真接住你。",
  };
  if (ringText) {
    const defaultText = ringText.textContent;
    document.querySelectorAll(".ring").forEach((r) => {
      r.addEventListener("mouseenter", () => {
        ringText.textContent = ringDescs[r.dataset.key] || defaultText;
      });
      r.addEventListener("mouseleave", () => {
        ringText.textContent = defaultText;
      });
    });
  }
</script>
