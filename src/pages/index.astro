---
// 首页：大标语 + 炫酷可视化 + 精选入口
import BaseLayout from "../layouts/BaseLayout.astro";

// 站点基础路径（部署时是 /shanglu-site/，本地开发是空）
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title="商陆也有禄 —— 普通人如何在当下社会里快速积累认知">
  <!-- 大标语区 -->
  <section class="hero">
    <p class="hero-eyebrow">🌿 一个普通人的认知积累笔记</p>
    <h1 class="hero-title">
      商陆<span>也有禄</span>
    </h1>
    <p class="hero-sub">
      普通人如何在当下社会里快速积累认知。<br />
      不贩卖焦虑，只记录真实的思考、模型与行动。
    </p>
    <div class="hero-actions">
      <a href={base + "/articles"} class="btn btn-primary">读文章</a>
      <a href={base + "/visuals"} class="btn btn-ghost">看可视化</a>
    </div>
  </section>

  <!-- 炫酷可视化占位（示例数据，后续换真实数据） -->
  <section class="section">
    <div class="section-head">
      <h2>📈 认知积累曲线</h2>
      <p>示例图表：持续学习的人与停滞的人，20 年后的差距</p>
    </div>
    <div class="chart-card">
      <div id="chart-cognition" class="chart"></div>
      <p class="chart-note">* 演示数据，仅展示效果，后续将接入真实数据</p>
    </div>
  </section>

  <!-- 精选入口 -->
  <section class="section">
    <div class="section-head">
      <h2>🚪 从这里开始</h2>
      <p>网站现在还是骨架，内容会一点点长出来</p>
    </div>
    <div class="card-grid">
      <a href={base + "/articles"} class="card">
        <h3>📝 文章</h3>
        <p>公众号长文沉淀：思维模型、认知方法、决策复盘</p>
      </a>
      <a href={base + "/knowledge"} class="card">
        <h3>📚 知识库</h3>
        <p>Obsidian 笔记公开版：主题化的长期积累，带关系图谱</p>
      </a>
      <a href={base + "/visuals"} class="card">
        <h3>📊 可视化</h3>
        <p>用数据讲故事：图表集、交互探索、数据大屏</p>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* 首页专属样式 */
  .hero {
    text-align: center;
    padding: 4rem 0 3.5rem;
  }

  .hero-eyebrow {
    color: var(--accent);
    font-size: 0.95rem;
    letter-spacing: 0.15em;
    margin-bottom: 1.2rem;
  }

  .hero-title {
    font-size: clamp(2.6rem, 8vw, 4.2rem);
    font-weight: 900;
    letter-spacing: 0.04em;
    line-height: 1.2;
    margin-bottom: 1.2rem;
    background: linear-gradient(120deg, #e6edf3 40%, var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-sub {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.9;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    padding: 0.7rem 1.8rem;
    border-radius: 999px;
    font-size: 0.95rem;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background: var(--accent);
    color: #0a0e17;
    font-weight: 600;
  }

  .btn-primary:hover {
    filter: brightness(1.15);
    transform: translateY(-2px);
  }

  .btn-ghost {
    border: 1px solid var(--border);
    color: var(--text);
  }

  .btn-ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
  }

  .section {
    margin-top: 3.5rem;
  }

  .section-head {
    margin-bottom: 1.4rem;
  }

  .section-head h2 {
    font-size: 1.4rem;
    margin-bottom: 0.3rem;
  }

  .section-head p {
    color: var(--muted);
    font-size: 0.92rem;
  }

  .chart-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.2rem;
  }

  .chart {
    width: 100%;
    height: 380px;
  }

  .chart-note {
    color: var(--muted);
    font-size: 0.78rem;
    text-align: right;
    padding-top: 0.5rem;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.2rem;
  }
</style>

<script>
  // 首页示例图表：认知积累曲线（ECharts）
  import * as echarts from "echarts";

  const chart = echarts.init(document.getElementById("chart-cognition"));
  chart.setOption({
    backgroundColor: "transparent",
    tooltip: { trigger: "axis" },
    legend: {
      data: ["持续学习者", "停滞者"],
      textStyle: { color: "#8b949e" },
      top: 0,
    },
    grid: { left: 50, right: 30, top: 40, bottom: 40 },
    xAxis: {
      type: "category",
      data: ["20岁", "25岁", "30岁", "35岁", "40岁", "45岁", "50岁", "55岁", "60岁"],
      axisLine: { lineStyle: { color: "#2a3a5c" } },
      axisLabel: { color: "#8b949e" },
    },
    yAxis: {
      type: "value",
      name: "认知水平",
      nameTextStyle: { color: "#8b949e" },
      splitLine: { lineStyle: { color: "#1a2540" } },
      axisLabel: { color: "#8b949e" },
    },
    series: [
      {
        name: "持续学习者",
        type: "line",
        smooth: true,
        data: [10, 22, 38, 55, 74, 90, 105, 118, 128],
        lineStyle: { color: "#2dd4bf", width: 3 },
        itemStyle: { color: "#2dd4bf" },
        areaStyle: {
          color: {
            type: "linear",
            x: 0, y: 0, x2: 0, y2: 1,
            colorStops: [
              { offset: 0, color: "rgba(45, 212, 191, 0.35)" },
              { offset: 1, color: "rgba(45, 212, 191, 0.02)" },
            ],
          },
        },
      },
      {
        name: "停滞者",
        type: "line",
        smooth: true,
        data: [10, 13, 15, 16, 17, 17, 18, 18, 18],
        lineStyle: { color: "#5b6b8c", width: 2, type: "dashed" },
        itemStyle: { color: "#5b6b8c" },
      },
    ],
  });

  // 窗口变化时自适应
  window.addEventListener("resize", () => chart.resize());
</script>
