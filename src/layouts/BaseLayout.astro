---
// 统一布局：全站页面共用同一个骨架（头部导航 + 内容区 + 页脚）
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

// 思源宋体（简体子集）：标题专用，杂志/书卷设计感
import "@fontsource/noto-serif-sc/chinese-simplified-600.css";
import "@fontsource/noto-serif-sc/chinese-simplified-700.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "商陆有四化 —— 普通人如何在当下社会里快速积累认知" } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- 防闪烁：页面渲染前先确定主题（本地记忆优先，否则跟随系统） -->
    <script is:inline>
      (function () {
        var t = localStorage.getItem("theme");
        if (!t) {
          t = window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        }
        document.documentElement.setAttribute("data-theme", t);
        // 标记 JS 可用（滚动浮现动画依赖 JS）
        document.documentElement.classList.add("js");
      })();
    </script>

    <!-- 全站全局样式：纯白留白风（宋体标题 + 黑体正文）+ 亮/暗双主题 -->
    <style is:global>
      /* ===== 亮色主题（默认，纯白留白） ===== */
      :root {
        --bg: #ffffff;
        --bg-soft: #fafafa;
        --bg-card: #ffffff;
        --bg-card-hover: #f7f7f7;
        --border: #e8e8e4;
        --text: #16161a;
        --muted: #6e6e76;
        --accent: #0d6e5e;
        --accent-soft: rgba(13, 110, 94, 0.08);
        --shadow: 0 10px 32px rgba(0, 0, 0, 0.06);
        --radius: 12px;
        --header-bg: rgba(255, 255, 255, 0.82);
        --grid-line: rgba(0, 0, 0, 0.035);
        --glow: rgba(13, 110, 94, 0.1);
        --font-serif: "Noto Serif SC", "Songti SC", "SimSun", serif;
        --font-sans:
          "PingFang SC", "Microsoft YaHei", "Noto Sans SC", "Segoe UI",
          sans-serif;
        --gold: #b8922e; /* 镂空装饰字金色 */
      }

      /* ===== 暗色主题（配套暗色调） ===== */
      [data-theme="dark"] {
        --bg: #0c0f14;
        --bg-soft: #141922;
        --bg-card: #141922;
        --bg-card-hover: #1a2130;
        --border: #212833;
        --text: #e8e8e8;
        --muted: #8a8f98;
        --accent: #4cc9b0;
        --accent-soft: rgba(76, 201, 176, 0.12);
        --shadow: 0 10px 32px rgba(0, 0, 0, 0.4);
        --header-bg: rgba(12, 15, 20, 0.82);
        --grid-line: rgba(255, 255, 255, 0.03);
        --glow: rgba(76, 201, 176, 0.08);
        --gold: #ddb84f; /* 镂空装饰字金色（暗色下更亮） */
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: var(--font-sans);
        background: var(--bg);
        color: var(--text);
        font-size: 18px;
        line-height: 1.85;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        transition: background 0.3s ease, color 0.3s ease;
      }

      /* 全页噪点纹理：细腻的纸张质感（设计细节） */
      body::after {
        content: "";
        position: fixed;
        inset: 0;
        z-index: 9999;
        pointer-events: none;
        opacity: 0.03;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)' opacity='0.6'/></svg>");
      }

      main {
        flex: 1;
        width: 100%;
        max-width: 860px;
        margin: 0 auto;
        padding: 5rem 1.5rem 5.5rem;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      /* 标题统一用宋体（设计感核心） */
      h1, h2, h3, .logo, .hero-title, .stat .num, .entry-title {
        font-family: var(--font-serif);
      }

      /* ===== 导航条 ===== */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: var(--header-bg);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--border);
      }

      .site-header .container {
        max-width: 860px;
        margin: 0 auto;
        padding: 0.85rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }

      .logo {
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        color: var(--text);
      }

      .logo span {
        color: var(--accent);
      }

      .nav-right {
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }

      nav {
        display: flex;
        gap: 0.3rem;
        flex-wrap: wrap;
      }

      .nav-link {
        padding: 0.4rem 0.9rem;
        border-radius: 999px;
        font-size: 0.95rem;
        color: var(--muted);
        transition: all 0.2s ease;
      }

      .nav-link:hover {
        color: var(--text);
        background: var(--bg-soft);
      }

      .nav-link.active {
        color: var(--accent);
        background: var(--accent-soft);
        font-weight: 600;
      }

      /* 建设中导航项 */
      .nav-disabled {
        opacity: 0.45;
        cursor: not-allowed;
      }

      .nav-disabled:hover {
        color: var(--muted);
        background: none;
      }

      /* 主题切换按钮 */
      .theme-toggle {
        border: 1px solid var(--border);
        background: var(--bg-card);
        color: var(--muted);
        width: 2.4rem;
        height: 2.4rem;
        border-radius: 999px;
        cursor: pointer;
        font-size: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
      }

      .theme-toggle:hover {
        color: var(--accent);
        border-color: var(--accent);
      }

      /* ===== 页脚 ===== */
      .site-footer {
        border-top: 1px solid var(--border);
        padding: 2.2rem 1.5rem;
        text-align: center;
        color: var(--muted);
        font-size: 0.88rem;
        letter-spacing: 0.03em;
      }

      .site-footer .footer-inner {
        max-width: 860px;
        margin: 0 auto;
      }

      /* ===== 通用标题区（杂志式：编号 + 标题 + 说明） ===== */
      .page-head {
        margin-bottom: 3rem;
      }

      .page-head h1 {
        font-size: 2.5rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        margin-bottom: 0.9rem;
      }

      .page-head p {
        color: var(--muted);
        font-size: 1.02rem;
      }

      /* ===== 通用卡片 ===== */
      .card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.7rem;
        transition: all 0.25s ease;
      }

      .card:hover {
        background: var(--bg-card-hover);
        border-color: var(--accent);
        box-shadow: var(--shadow);
        transform: translateY(-2px);
      }

      .card h3 {
        margin-bottom: 0.5rem;
        font-size: 1.3rem;
        font-weight: 700;
        letter-spacing: 0.02em;
      }

      .card p {
        color: var(--muted);
        font-size: 0.98rem;
      }

      /* ===== 占位提示 ===== */
      .placeholder {
        border: 1px dashed var(--border);
        border-radius: var(--radius);
        padding: 3.5rem 1.5rem;
        text-align: center;
        color: var(--muted);
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
